# Server
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL: use DATABASE_URL or the individual PG* values below.
DATABASE_URL=
PGHOST=your-project-ref.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.your-project-ref
PGPASSWORD=replace_with_database_password
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
ALLOW_PRODUCTION_ADMIN_SEED=true
# Generate unique random secrets (at least 32 characters) for each environment.
JWT_ACCESS_SECRET=replace_with_a_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_random_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=https://api.httacademy.local
JWT_AUDIENCE=htt-academy-web
PASSWORD_RESET_URL=http://localhost:5173/reset-password
AUTH_COOKIE_SAME_SITE=strict
LOGIN_RATE_LIMIT=10
PASSWORD_RESET_RATE_LIMIT=5

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Academy <noreply@example.com>

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
# Local Vite development server (vite.config.js has no port override; Vite defaults to 5173).
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback
# New Paystack-Signature HMAC secret from the dashboard (whsec_...). Optional until enabled.
PAYSTACK_WEBHOOK_SECRET=whsec_your_dashboard_signing_secret
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT_MS=10000

# External notification delivery is disabled until explicitly enabled.
NOTIFICATIONS_ENABLED=false
# Optional generic SMS REST provider: POST {to,from,text} with Bearer auth.
SMS_API_URL=https://sms-provider.example/api/messages
SMS_API_KEY=replace_with_sms_provider_key
SMS_SENDER_ID=HTTAcademy
NOTIFICATION_WORKER_INTERVAL_MS=5000

# Optional first administrator bootstrap. Keep blank until seeding an isolated
# development/test database. Use a unique strong password and never commit it.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
