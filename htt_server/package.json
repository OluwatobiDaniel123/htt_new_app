{
  "name": "htt-academy-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/auth/auth.test.js dist/recruitment/coachingApprentice.test.js dist/scripts/schemaTypes.test.js dist/scripts/productionSchemaDiagnostics.test.js dist/middleware/publicRegistrationUpload.test.js",
    "seed": "npm run build && node dist/scripts/seedAdmin.js",
    "lint": "eslint src eslint.config.js sequelize-cli-config.cjs",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed:public-centres": "npm run build && node dist/scripts/seedPublicCentres.js",
    "db:production-setup": "node dist/scripts/productionSetup.js",
    "db:diagnose-production-schema": "node dist/scripts/diagnoseProductionSchema.js",
    "db:reconcile-production-types": "node dist/scripts/reconcileProductionTypes.js",
    "db:seed:rbac": "sequelize-cli db:seed --seed 20261029000000-seed-rbac.cjs",
    "db:seed:phase4": "sequelize-cli db:seed --seed 20261029000001-phase4-academy-permissions.cjs",
    "db:seed:phase5": "sequelize-cli db:seed --seed 20261029000002-phase5-finance-permissions.cjs",
    "db:seed:phase6": "sequelize-cli db:seed --seed 20261029000003-phase6-notification-permissions.cjs",
    "db:seed:phase7": "sequelize-cli db:seed --seed 20261030000000-phase7-safeguarding-permissions.cjs",
    "db:seed:recruitment-permission": "sequelize-cli db:seed --seed 20261102000000-coaching-apprentice-permission.cjs",
    "migration:dry-run": "node scripts/base44-migration-dry-run.cjs"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "pino-http": "^10.4.0",
    "resend": "^6.35.0",
    "sequelize": "^6.37.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.24.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
