{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "general",
        "registration",
        "assessment",
        "callback",
        "partnership",
        "sponsorship",
        "school_project"
      ],
      "default": "general"
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "phone",
        "walk_in",
        "referral",
        "social",
        "event",
        "admin"
      ],
      "default": "admin"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "new"
    },
    "assigned_to": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "next_follow_up": {
      "type": "string",
      "format": "date"
    },
    "consent_to_contact": {
      "type": "boolean",
      "default": true
    },
    "opted_out": {
      "type": "boolean",
      "default": false
    },
    "communication_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "by": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "contact_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ceo"
          }
        },
        {
          "user_condition": {
            "role": "operations"
          }
        },
        {
          "user_condition": {
            "role": "marketing"
          }
        },
        {
          "user_condition": {
            "role": "sponsorship"
          }
        }
      ]
    }
  }
}