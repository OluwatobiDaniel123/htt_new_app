{
  "name": "Assessment",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "registration_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "trial",
        "periodic",
        "scholarship"
      ],
      "default": "trial"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "centre_id": {
      "type": "string"
    },
    "centre_name": {
      "type": "string"
    },
    "coach_email": {
      "type": "string"
    },
    "coach_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "scheduled"
    },
    "criteria_scores": {
      "type": "object",
      "properties": {
        "technical_ability": {
          "type": "number"
        },
        "tactical_understanding": {
          "type": "number"
        },
        "teamwork": {
          "type": "number"
        },
        "attitude": {
          "type": "number"
        },
        "development_potential": {
          "type": "number"
        }
      }
    },
    "overall_rating": {
      "type": "number"
    },
    "feedback": {
      "type": "string"
    },
    "improvement_targets": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "player_name",
    "scheduled_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ceo"
          }
        },
        {
          "user_condition": {
            "role": "operations"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    }
  }
}