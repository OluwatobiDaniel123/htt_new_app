{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "ceo",
        "finance",
        "operations",
        "coach",
        "marketing",
        "sponsorship",
        "user"
      ],
      "default": "user",
      "description": "Staff role. admin = System Administrator."
    },
    "phone": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "centres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  }
}