{
  "name": "Registration",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "guardian_name": {
      "type": "string"
    },
    "guardian_email": {
      "type": "string"
    },
    "guardian_phone": {
      "type": "string"
    },
    "guardian_address": {
      "type": "string"
    },
    "child_name": {
      "type": "string"
    },
    "child_date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "centre_id": {
      "type": "string"
    },
    "centre_name": {
      "type": "string"
    },
    "programme_id": {
      "type": "string"
    },
    "programme_name": {
      "type": "string"
    },
    "age_group": {
      "type": "string"
    },
    "pathway": {
      "type": "string",
      "enum": [
        "paid_academy",
        "scholarship_assessment"
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "file_uri": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "rejected"
            ]
          },
          "verified_by": {
            "type": "string"
          }
        }
      }
    },
    "document_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "consent_media": {
      "type": "boolean",
      "default": false
    },
    "consent_data": {
      "type": "boolean",
      "default": false
    },
    "consent_medical": {
      "type": "boolean",
      "default": false
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "partial",
        "paid",
        "not_required"
      ],
      "default": "unpaid"
    },
    "amount_due": {
      "type": "number"
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "payment_reference": {
      "type": "string"
    },
    "assigned_reviewer": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "assessment_required",
        "information_required",
        "approved",
        "rejected"
      ],
      "default": "submitted"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "by": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "admin",
        "public_website"
      ],
      "default": "admin"
    },
    "linked_player_id": {
      "type": "string"
    }
  },
  "required": [
    "child_name",
    "guardian_name",
    "guardian_phone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ceo"
          }
        },
        {
          "user_condition": {
            "role": "operations"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    }
  }
}