{
  "name": "ConsentRecord",
  "type": "object",
  "properties": {
    "subject_type": {
      "type": "string",
      "enum": [
        "player",
        "guardian"
      ],
      "default": "player"
    },
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "guardian_id": {
      "type": "string"
    },
    "guardian_name": {
      "type": "string"
    },
    "consent_type": {
      "type": "string",
      "enum": [
        "media_photography",
        "media_video",
        "data_processing",
        "medical",
        "travel"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "granted",
        "pending",
        "withdrawn"
      ],
      "default": "pending"
    },
    "granted_at": {
      "type": "string",
      "format": "date"
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "document_uri": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "player_name",
    "consent_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ceo"
          }
        },
        {
          "user_condition": {
            "role": "operations"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "marketing"
          }
        }
      ]
    }
  }
}