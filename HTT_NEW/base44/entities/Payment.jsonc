{
  "name": "Payment",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "registration_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "payer_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "method": {
      "type": "string",
      "enum": [
        "paystack",
        "bank_transfer",
        "cash",
        "pos",
        "waiver"
      ],
      "default": "bank_transfer"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "registration",
        "assessment",
        "scholarship_contribution",
        "other"
      ],
      "default": "registration"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded",
        "partially_refunded"
      ],
      "default": "pending"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "receipt_number": {
      "type": "string"
    },
    "gateway_reference": {
      "type": "string"
    },
    "refund_amount": {
      "type": "number"
    },
    "refund_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "payer_name",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ceo"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "operations"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ceo"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ceo"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ceo"
          }
        }
      ]
    }
  }
}