{
  "name": "FundingRecord",
  "type": "object",
  "properties": {
    "sponsor_id": {
      "type": "string"
    },
    "sponsor_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "individual_player",
        "scholarship_fund",
        "school_project",
        "corporate_partnership"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "pledge",
        "payment",
        "refund"
      ],
      "default": "pledge"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "reference": {
      "type": "string"
    },
    "record_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pledged",
        "confirmed",
        "received",
        "cancelled"
      ],
      "default": "pledged"
    },
    "target_label": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "sponsor_name",
    "category",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ceo"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "sponsorship"
          }
        },
        {
          "user_condition": {
            "role": "operations"
          }
        }
      ]
    }
  }
}