{
  "name": "ScholarshipApplication",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "applicant_name": {
      "type": "string"
    },
    "guardian_name": {
      "type": "string"
    },
    "guardian_email": {
      "type": "string"
    },
    "guardian_phone": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "centre_id": {
      "type": "string"
    },
    "centre_name": {
      "type": "string"
    },
    "programme_id": {
      "type": "string"
    },
    "programme_name": {
      "type": "string"
    },
    "eligibility_checks": {
      "type": "object",
      "properties": {
        "age_ok": {
          "type": "boolean"
        },
        "residence_ok": {
          "type": "boolean"
        },
        "financial_need_ok": {
          "type": "boolean"
        },
        "documents_ok": {
          "type": "boolean"
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "file_uri": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "assessment_id": {
      "type": "string"
    },
    "assessment_result": {
      "type": "string"
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "eligibility_review",
        "assessment_scheduled",
        "assessed",
        "selection_panel",
        "approved",
        "waitlisted",
        "declined"
      ],
      "default": "received"
    },
    "decision_notes": {
      "type": "string"
    },
    "decision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "by": {
            "type": "string"
          }
        }
      }
    },
    "award_amount": {
      "type": "number"
    },
    "funding_secured": {
      "type": "number",
      "default": 0
    },
    "funding_required": {
      "type": "number",
      "default": 0
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "renewal_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "applicant_name",
    "guardian_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ceo"
          }
        },
        {
          "user_condition": {
            "role": "operations"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "sponsorship"
          }
        }
      ]
    }
  }
}