{
  "name": "Player",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "age_group": {
      "type": "string",
      "enum": [
        "8-10",
        "11-12",
        "13-14",
        "other"
      ]
    },
    "centre_id": {
      "type": "string"
    },
    "centre_name": {
      "type": "string"
    },
    "programme_id": {
      "type": "string"
    },
    "programme_name": {
      "type": "string"
    },
    "registration_status": {
      "type": "string",
      "enum": [
        "prospective",
        "registered",
        "waitlisted",
        "archived"
      ],
      "default": "registered"
    },
    "scholarship_status": {
      "type": "string",
      "enum": [
        "none",
        "applicant",
        "active",
        "declined"
      ],
      "default": "none"
    },
    "document_verification": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "development_notes": {
      "type": "string"
    },
    "match_appearances": {
      "type": "number",
      "default": 0
    },
    "match_notes": {
      "type": "string"
    },
    "school": {
      "type": "string"
    },
    "safeguarding_notes": {
      "type": "string"
    },
    "guardian_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_guardian_name": {
      "type": "string"
    },
    "registration_id": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "archived_reason": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "date_of_birth"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ceo"
          }
        },
        {
          "user_condition": {
            "role": "operations"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    }
  }
}